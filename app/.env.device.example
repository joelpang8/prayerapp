# Your iPhone build, against your real Firebase project (not the emulators).
# Copy to .env.device (git-ignored) and fill in. Used only by `npm run ios:device`;
# the Simulator keeps using .env.

# A unique reverse-DNS id of your own, e.g. com.yourname.praynow. Apple must
# never have seen it on another account. Avoid changing it often: a free
# Personal Team may register only 10 new ids a week.
IOS_BUNDLE_ID=

# Firebase console > Project settings > Your apps > Web app (the config object).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=prayerapp-4ce99.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=prayerapp-4ce99
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=prayerapp-4ce99.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in (the only sign-in on a free account).
# From the iOS app's GoogleService-Info.plist (Firebase > Your apps > iOS app):
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=     # CLIENT_ID
GOOGLE_IOS_URL_SCHEME=                # REVERSED_CLIENT_ID
# Firebase > Authentication > Sign-in method > Google > Web SDK configuration:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=     # Web client ID

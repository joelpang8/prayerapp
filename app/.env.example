# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In: from the iOS OAuth client in Google Cloud console
# (created automatically when you add an iOS app in Firebase).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The "Web client (auto created by Google Service)" client id. Needed so the
# Google id token is accepted by Firebase Auth.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=

# Sign in with Apple: set to 1 only once you have the paid Apple Developer
# Program (it needs a signing certificate, even in the Simulator). Then run
# `npx expo prebuild --clean` so the entitlement is added.
# EXPO_PUBLIC_APPLE_SIGN_IN=1

# Real push notifications to iPhones: same requirement (paid program, plus an
# APNs key in Firebase). Simulator notifications from `npm run dev:prompt`
# work without it. Run `npx expo prebuild --clean` after changing it.
# REMOTE_PUSH=1

# Your own reverse-DNS bundle id; must match the App ID in your Apple developer account.
IOS_BUNDLE_ID=

# Local development against the emulators (cd ../firebase && npm run emulators).
# EXPO_PUBLIC_USE_EMULATORS=1
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.20

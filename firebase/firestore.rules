rules_version = '2';

// Security model (see docs/step1-auth-friends.md for the full rationale):
//
// * Friendship = mutual follow. A friendship exists between A and B only
//   while BOTH follows/{A}_{B} and follows/{B}_{A} exist.
// * Post visibility is decided at read time against those live follow docs,
//   never against a copied/denormalized friend list. Deleting either follow
//   doc revokes access on the very next server read.
// * Everything not explicitly allowed below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      // Anonymous accounts are rejected even if the provider is accidentally
      // enabled in the console: they would let anyone mint unlimited
      // identities to spam follow requests.
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernameDoc(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    function follows(a, b) {
      return exists(/databases/$(database)/documents/follows/$(a + '_' + b));
    }

    function areFriends(a, b) {
      return follows(a, b) && follows(b, a);
    }

    // Firebase Auth uids are alphanumeric. Requiring that here keeps the
    // "{follower}_{followee}" doc id unambiguous.
    function isValidUid(uid) {
      return uid is string && uid.matches('^[A-Za-z0-9]{1,128}$');
    }

    function isValidUsername(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$');
    }

    function isValidDisplayName(name) {
      return name is string && name.size() >= 1 && name.size() <= 50;
    }

    // ---------- public profiles ----------
    // Minimal: username, display name and (optional) profile photo path.
    // Readable by any signed-in user who already knows the uid (needed to
    // show a follow request / friend, and to recognise who it is). Listing
    // is denied so the user base can't be enumerated. The bio is NOT here:
    // it's friends-only (users/{uid}/friendsOnly/about below).
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;

      // Profile + username claim must be written in the same batch.
      allow create: if isSelf(uid)
        && isValidUid(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['username', 'displayName', 'createdAt'])
        && isValidUsername(request.resource.data.username)
        && isValidDisplayName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        && getAfter(usernameDoc(request.resource.data.username)).data.uid == uid;

      // Display name and profile photo are mutable. The photo must be in the
      // owner's own avatars/ folder (storage rules only let the owner write
      // there); removing it deletes the field.
      // The username can change too, but only as one batch that claims the
      // new name (usernames/{new} pointing at me) and releases the old one
      // (usernames/{old} deleted), so a name is never held by two people and
      // I never hold two names.
      allow update: if isSelf(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarPath'])
          && isValidDisplayName(request.resource.data.displayName)
          && (!('avatarPath' in request.resource.data)
              || (request.resource.data.avatarPath is string
                  && request.resource.data.avatarPath.matches('^avatars/' + uid + '/[A-Za-z0-9]{1,64}[.]jpg$'))))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
          && isValidUsername(request.resource.data.username)
          && request.resource.data.username != resource.data.username
          && getAfter(usernameDoc(request.resource.data.username)).data.uid == uid
          && !existsAfter(usernameDoc(resource.data.username))));

      // Account deletion goes through a Cloud Function (step 5) so that the
      // user's posts, follows and photos are removed together.
      allow delete: if false;

      // ---------- friends-only profile ----------
      // users/{uid}/friendsOnly/about: { bio } (up to 160 characters).
      // Same boundary as posts: only the owner and CURRENT mutual friends,
      // checked against the live follow docs on every read.
      // Posts, comments and circle requests I've reported, hidden from my
      // own view. Only I can read or change this list. Key: "post_{postId}",
      // "comment_{postId}_{commentId}" or "circle_{circleId}_{requestId}".
      match /hidden/{key} {
        allow get, list, delete: if isSelf(uid);
        allow create: if isSelf(uid)
          && key.matches('^(post_[A-Za-z0-9_]{1,200}|comment_[A-Za-z0-9_]{1,200}|circle_[A-Za-z0-9_]{1,200})$')
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      match /friendsOnly/{docId} {
        allow get: if docId == 'about' && signedIn() && (
          request.auth.uid == uid || areFriends(request.auth.uid, uid));
        allow list: if false;
        // The friends-only "about" fields. Each is optional; an empty field
        // is left out rather than stored empty (the bio may be "").
        function optionalText(d, key, max) {
          return !(key in d) || (d[key] is string && d[key].size() >= 1 && d[key].size() <= max);
        }
        // "MM-DD", or "YYYY-MM-DD" if they choose to share the year.
        function validBirthday(d) {
          return !('birthday' in d) || (d.birthday is string
            && d.birthday.matches('^([0-9]{4}-)?(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
        }
        // Prayer requests are one per line, up to 10. requestIds gives each
        // line a random id (same order) that friends' "I'll pray for this"
        // taps point at; a line whose text changes gets a new id, so its
        // count starts again. Present exactly when prayerRequests is.
        // Rules have no loops: check each of the (at most 10) ids is a string.
        function allStrings(ids) {
          return (ids.size() <= 0 || ids[0] is string) && (ids.size() <= 1 || ids[1] is string)
            && (ids.size() <= 2 || ids[2] is string) && (ids.size() <= 3 || ids[3] is string)
            && (ids.size() <= 4 || ids[4] is string) && (ids.size() <= 5 || ids[5] is string)
            && (ids.size() <= 6 || ids[6] is string) && (ids.size() <= 7 || ids[7] is string)
            && (ids.size() <= 8 || ids[8] is string) && (ids.size() <= 9 || ids[9] is string);
        }
        function validRequests(d) {
          return ('prayerRequests' in d)
            ? (d.requestIds is list
               && d.requestIds.size() == d.prayerRequests.split('\n').size()
               && d.requestIds.size() <= 10
               && allStrings(d.requestIds)
               && d.requestIds.toSet().size() == d.requestIds.size()
               && d.requestIds.join(',').matches('^[A-Za-z0-9]{8,32}(,[A-Za-z0-9]{8,32})*$'))
            : !('requestIds' in d);
        }
        // Answered requests: answeredIds (each one of requestIds, no repeats)
        // with answerNotes in the same order, each a note of up to 120
        // characters (may be empty). Present together, or not at all.
        function noteOk(notes, i) {
          return notes.size() <= i || (notes[i] is string && notes[i].size() <= 120);
        }
        function validAnswers(d) {
          return ('answeredIds' in d)
            ? ('requestIds' in d
               && d.answeredIds is list && d.answeredIds.size() >= 1 && d.answeredIds.size() <= 10
               && allStrings(d.answeredIds)
               && d.answeredIds.toSet().size() == d.answeredIds.size()
               && d.requestIds.toSet().hasAll(d.answeredIds)
               && d.answerNotes is list && d.answerNotes.size() == d.answeredIds.size()
               && noteOk(d.answerNotes, 0) && noteOk(d.answerNotes, 1) && noteOk(d.answerNotes, 2)
               && noteOk(d.answerNotes, 3) && noteOk(d.answerNotes, 4) && noteOk(d.answerNotes, 5)
               && noteOk(d.answerNotes, 6) && noteOk(d.answerNotes, 7) && noteOk(d.answerNotes, 8)
               && noteOk(d.answerNotes, 9))
            : !('answerNotes' in d);
        }
        allow create, update: if isSelf(uid)
          && docId == 'about'
          && request.resource.data.keys().hasOnly(['bio', 'birthday', 'hometown', 'prayerRequests', 'requestIds', 'answeredIds', 'answerNotes', 'bibleVersion', 'denomination', 'church'])
          && validRequests(request.resource.data)
          && validAnswers(request.resource.data)
          && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
          && validBirthday(request.resource.data)
          && optionalText(request.resource.data, 'prayerRequests', 500)
          && optionalText(request.resource.data, 'bibleVersion', 40)
          && optionalText(request.resource.data, 'denomination', 60)
          && optionalText(request.resource.data, 'church', 80)
          && optionalText(request.resource.data, 'hometown', 80);
        // Clear the bio by saving an empty one; the doc goes with the account (step 5).
        allow delete: if false;
      }

      // ---------- "I'll pray for this" ----------
      // users/{uid}/prayingFor/{itemId}_{friendUid}: a CURRENT mutual friend
      // of {uid} is praying for one of {uid}'s prayer requests (an id in
      // their about.requestIds). One per friend per request (the doc id).
      // Nothing is sent to {uid}; they see a count when they look.
      //  * Only the owner can list them all. Their app counts only taps from
      //    current friends on current requests, and Cloud Functions delete
      //    taps when a friendship ends or a request is removed or changed.
      //  * A friend can read only their own taps, and only while friends.
      //    Nobody else can read any, so other friends never see who tapped
      //    or how many.
      //  * Not on your own requests. Undo = the tapper deletes their own.
      match /prayingFor/{tapId} {
        function aboutData() {
          return get(/databases/$(database)/documents/users/$(uid)/friendsOnly/about).data;
        }

        allow get, list: if signedIn() && (
          request.auth.uid == uid ||
          (resource.data.friendUid == request.auth.uid && areFriends(request.auth.uid, uid)));

        allow create: if signedIn()
          && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['friendUid', 'itemId', 'createdAt'])
          && request.resource.data.keys().hasAll(['friendUid', 'itemId', 'createdAt'])
          && request.resource.data.friendUid == request.auth.uid
          && request.resource.data.itemId is string
          && tapId == request.resource.data.itemId + '_' + request.auth.uid
          && request.resource.data.createdAt == request.time
          && areFriends(request.auth.uid, uid)
          && request.resource.data.itemId in aboutData().get('requestIds', [])
          // An answered request doesn't take new "I'll pray for this" taps.
          && !(request.resource.data.itemId in aboutData().get('answeredIds', []));

        allow update: if false;
        allow delete: if signedIn() && resource.data.friendUid == request.auth.uid;
      }

      // ---------- private settings ----------
      // users/{uid}/private/settings: only the owner can read or write it.
      // Friends never see it.
      //   bibleVersion: the translation this user reads verses in.
      // Only translations on this list can be chosen. KJV and RV1909
      // (Reina-Valera 1909, Spanish) are public domain;
      // licensed translations are added here only once their licence
      // allows it. Must match app/src/lib/scripture/translations.ts.
      match /private/{docId} {
        function allowedTranslations() {
          return ['KJV', 'BSB', 'WEB', 'ASV', 'YLT', 'DARBY', 'WEBSTER', 'DRA', 'RV1909'];
        }

        // verseIndex: { books: {PHP: 3}, refs: {"PHP.4.6-7": 2} }, the verses
        // of my own posts, for the Prayers tab's verse filter. Written only
        // by a Cloud Function.
        // notify: opt-in notifications about my own things (a friend praying
        // for my requests, reactions and comments on my prayers). topic is a
        // secret random channel name only my phone listens on and only the
        // server sends to; no push tokens are stored. lang picks the wording.
        function validNotify() {
          let d = request.resource.data;
          return d.keys().hasOnly(['topic', 'taps', 'reactions', 'comments', 'lang', 'circles'])
            && d.keys().hasAll(['topic', 'taps', 'reactions', 'comments', 'lang'])
            && d.topic is string && d.topic.matches('^n_[A-Za-z0-9]{32}$')
            && d.taps is bool && d.reactions is bool && d.comments is bool
            && d.lang in ['en', 'es']
            // Prayer circles to be told about (ids, up to 50).
            && (!('circles' in d) || (d.circles is list && d.circles.size() <= 50
                && (d.circles.size() == 0 || (d.circles.join(',').matches('^[A-Za-z0-9]{1,40}(,[A-Za-z0-9]{1,40})*$')
                    // and no id hides a comma
                    && d.circles.join(',').split(',').size() == d.circles.size()))));
        }

        allow get: if isSelf(uid) && docId in ['settings', 'verseIndex', 'notify'];
        allow list: if false;
        allow create, update: if isSelf(uid) && (
          (docId == 'settings'
            && request.resource.data.keys().hasOnly(['bibleVersion'])
            && request.resource.data.bibleVersion in allowedTranslations())
          || (docId == 'notify' && validNotify()));
        // Removed with the account (step 5), not by clients.
        allow delete: if false;
      }

      // ---------- "Pray now" starts ----------
      // users/{uid}/starts/{promptId}: when I pressed "Pray now" for a
      // prompt. Only allowed while that prompt is still on time (the first
      // 7 minutes: 2 to pray + 5 grace; must match ON_TIME_WINDOW_MS in
      // app/src/lib/posts.ts), at the server's time. A post that carries this
      // startedAt and is made within 15 minutes of it counts as on time, so
      // people can take their time praying. Cancelling deletes it. Only the
      // owner can read it; removed with the account.
      match /starts/{promptId} {
        function startPrompt() {
          return get(/databases/$(database)/documents/prompts/$(promptId)).data;
        }
        allow get: if isSelf(uid);
        allow list: if false;
        allow create: if isSelf(uid)
          && promptId.matches('^[0-9]{8}$')
          && exists(/databases/$(database)/documents/prompts/$(promptId))
          && request.resource.data.keys().hasOnly(['startedAt'])
          && request.resource.data.startedAt == request.time
          && request.time >= startPrompt().firedAt
          && request.time <= startPrompt().firedAt + duration.value(7, 'm');
        allow update: if false;
        allow delete: if isSelf(uid);
      }

      // ---------- saved verses (scripture memory) ----------
      // users/{uid}/savedVerses/{refId}: verses I've saved to read or listen
      // to again. Only the owner can see or change them; friends never see
      // them. Only the reference is stored, never the verse text. The doc id
      // is the reference, so a verse is saved once. Unsave = delete.
      match /savedVerses/{refId} {
        allow get, list: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['verseRef', 'savedAt'])
          && request.resource.data.verseRef == refId
          && refId.matches('^[1-3]?[A-Z]{2,3}[.][0-9]{1,3}([.][0-9]{1,3}(-[0-9]{1,3}([.][0-9]{1,3})?)?)?$')
          && request.resource.data.savedAt == request.time;
        allow update: if false;
        allow delete: if isSelf(uid);
      }

      // ---------- my prayer list ----------
      // users/{uid}/prayerList/{itemId}: people and things I pray for. Only
      // the owner can see or change it; nobody else, ever (not friends, not
      // circles). Names are typed in, never linked to anyone's account.
      match /prayerList/{itemId} {
        function validItem(d) {
          return d.keys().hasOnly(['name', 'note', 'group', 'often', 'order', 'createdAt', 'answeredAt', 'answerNote'])
            && d.keys().hasAll(['name', 'note', 'group', 'often', 'order', 'createdAt'])
            && d.name is string && d.name.trim().size() > 0 && d.name.size() <= 60
            && d.note is string && d.note.size() <= 200
            && d.group is string && d.group.trim().size() > 0 && d.group.size() <= 30
            && d.often in ['daily', 'weekly', 'monthly']
            && d.order is int && d.order >= 0 && d.order <= 1000000
            && (!('answeredAt' in d) || d.answeredAt is timestamp)
            && (!('answerNote' in d) || (d.answerNote is string && d.answerNote.size() <= 120 && 'answeredAt' in d));
        }
        allow get, list: if isSelf(uid);
        allow create: if isSelf(uid)
          && itemId.matches('^[A-Za-z0-9]{1,40}$')
          && validItem(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isSelf(uid)
          && validItem(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isSelf(uid);
      }
    }

    // ---------- username -> uid index ----------
    // Exact-match lookup only ("add friend by username"). No list.
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;

      // A user holds exactly one username. It's claimed while creating the
      // profile (the profile doesn't exist yet, and after the batch points
      // back at this username), or when changing it (the profile pointed at
      // another name before the batch and at this one after; the old claim
      // is released in the same batch, see users/{uid} update). Create fails
      // if already taken because the doc already exists (that would be an
      // update).
      allow create: if signedIn()
        && isValidUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userDoc(request.auth.uid)).data.username == username
        && (!exists(userDoc(request.auth.uid))
            || get(userDoc(request.auth.uid)).data.username != username);

      // Releasing my old name: only in the batch that moves my profile to a
      // new one. Nobody else's claim can be deleted or reassigned.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && existsAfter(userDoc(request.auth.uid))
        && getAfter(userDoc(request.auth.uid)).data.username != username;

      allow update: if false;
    }

    // ---------- follows (friend requests / friendships) ----------
    // follows/{followerId}_{followeeId}
    //   A one-directional follow is a pending friend request.
    //   Both directions present = friends.
    match /follows/{followId} {
      function party() {
        return signedIn() && (
          resource.data.followerId == request.auth.uid ||
          resource.data.followeeId == request.auth.uid);
      }

      // Only the two people involved can see a follow edge. Queries must be
      // constrained to `followerId == me` or `followeeId == me`.
      allow get, list: if party();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerId', 'followeeId', 'createdAt'])
        && request.resource.data.keys().hasAll(['followerId', 'followeeId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && isValidUid(request.resource.data.followeeId)
        && request.resource.data.followeeId != request.auth.uid
        && followId == request.resource.data.followerId + '_' + request.resource.data.followeeId
        && request.resource.data.createdAt == request.time
        && exists(userDoc(request.resource.data.followeeId))
        // Follower must have a profile too, so requests always render.
        && exists(userDoc(request.auth.uid))
        // You can't send a request to someone you've blocked (unblock first).
        // Someone you've blocked CAN still send you one, so the block stays
        // secret, but your app never shows it and you can't accept it.
        && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + request.resource.data.followeeId));

      // Edges are immutable; changing followerId/followeeId would forge
      // friendships.
      allow update: if false;

      // Either party may delete an edge:
      //   follower deletes -> cancel request / unfriend
      //   followee deletes -> decline request / unfriend
      allow delete: if party();
    }

    // ---------- prompts ----------
    // prompts/{yyyymmdd}: one global prompt per day (v1: everyone at once).
    //   firedAt:  timestamp the prompt went out
    //   verseRef: optional canonical verse reference id (e.g. "PHP.4.6-7")
    //             from the curated list; never verse text
    // Written only by the server (Cloud Function in step 4, or the dev seed
    // script against the emulator). Readable by any signed-in user.
    match /prompts/{promptId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- blocks ----------
    // blocks/{blocker}_{blocked}. Only the blocker can see their blocks;
    // the blocked person is never told. Blocking also ends the friendship
    // (the app deletes both follow edges in the same batch), and the follow
    // rule above stops the blocker sending a request until they unblock.
    match /blocks/{blockId} {
      allow get, list, delete: if signedIn() && resource.data.blocker == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['blocker', 'blocked', 'createdAt'])
        && request.resource.data.blocker == request.auth.uid
        && isValidUid(request.resource.data.blocked)
        && request.resource.data.blocked != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blocked
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // ---------- reports ----------
    // Write-only for users; the project owner reviews them in the Firebase
    // console (the Admin SDK and console bypass these rules). A short text
    // excerpt is kept with the report so it survives the content's deletion.
    // ---------- prayer circles ----------
    // circles/{circleId}: { name, leaderId, memberIds, invitedIds, createdAt,
    //   photoPath?, pinnedRequestId?, prayerTime?, linkCode? }
    // A small named group (up to 30, members + invited) with a shared prayer
    // list. Members see each other's names and the circle's requests even if
    // they aren't friends; nothing else (profiles, posts) is shared through a
    // circle. Only the leader invites, one friend at a time; nobody is a
    // member until they accept. Leaving or being removed ends access at once
    // (every read checks the live member list).
    match /circles/{circleId} {
      function validCircleName(n) {
        return n is string && n.trim().size() >= 1 && n.size() <= 40;
      }
      function isLeader() {
        return request.auth.uid == resource.data.leaderId;
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // One id left the list, nothing else changed or was added.
      function removedOne(before, after) {
        return after.size() == before.size() - 1 && before.toSet().hasAll(after) && after.toSet().size() == after.size();
      }
      function validPrayerTime(p) {
        return p is map && p.keys().hasOnly(['weekday', 'hour', 'minute', 'timeZone'])
          && p.keys().hasAll(['weekday', 'hour', 'minute', 'timeZone'])
          && p.weekday is int && p.weekday >= 1 && p.weekday <= 7
          && p.hour is int && p.hour >= 0 && p.hour <= 23
          && p.minute is int && p.minute >= 0 && p.minute <= 59
          && p.timeZone is string && p.timeZone.matches('^[A-Za-z_]+(/[A-Za-z0-9_+-]+){0,2}$') && p.timeZone.size() <= 64;
      }
      function newestMember() {
        return request.resource.data.memberIds[request.resource.data.memberIds.size() - 1];
      }
      function newestInvite() {
        return request.resource.data.invitedIds[request.resource.data.invitedIds.size() - 1];
      }

      allow get, list: if signedIn()
        && (request.auth.uid in resource.data.memberIds || request.auth.uid in resource.data.invitedIds);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'leaderId', 'memberIds', 'invitedIds', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'leaderId', 'memberIds', 'invitedIds', 'createdAt'])
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.invitedIds == []
        && validCircleName(request.resource.data.name)
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && (
        // The leader renames it.
        (isLeader() && changed().hasOnly(['name']) && validCircleName(request.resource.data.name))
        // The leader hands the circle to another current member (who then
        // leads it: invites, approvals, photo, link). Nothing else changes.
        || (isLeader() && changed().hasOnly(['leaderId'])
            && request.resource.data.leaderId is string
            && request.resource.data.leaderId != request.auth.uid
            && request.resource.data.leaderId in resource.data.memberIds)
        // The leader pins one of its requests to the top, or unpins.
        || (isLeader() && changed().hasOnly(['pinnedRequestId'])
            && (!('pinnedRequestId' in request.resource.data)
                || (request.resource.data.pinnedRequestId is string
                    && exists(/databases/$(database)/documents/circles/$(circleId)/circleRequests/$(request.resource.data.pinnedRequestId)))))
        // The leader sets (or clears) a weekly prayer time: a weekday (1 =
        // Monday ... 7 = Sunday), an hour and minute, in the leader's time zone.
        || (isLeader() && changed().hasOnly(['prayerTime'])
            && (!('prayerTime' in request.resource.data) || validPrayerTime(request.resource.data.prayerTime)))
        // The leader turns the invite link on (pointing at its circleLinks
        // card, made in the same batch) or off.
        || (isLeader() && changed().hasOnly(['linkCode'])
            && (!('linkCode' in request.resource.data)
                || (request.resource.data.linkCode is string
                    && getAfter(/databases/$(database)/documents/circleLinks/$(request.resource.data.linkCode)).data.circleId == circleId)))
        // The leader approves someone who asked to join with the link.
        || (isLeader() && changed().hasOnly(['memberIds'])
            && request.resource.data.memberIds == resource.data.memberIds.concat([newestMember()])
            && exists(/databases/$(database)/documents/circles/$(circleId)/joinRequests/$(newestMember()))
            && !(newestMember() in resource.data.memberIds)
            && !(newestMember() in resource.data.invitedIds)
            && request.resource.data.memberIds.size() + resource.data.invitedIds.size() <= 30)
        // The leader sets or removes its photo (in its own circlePhotos/ folder,
        // which only the leader can write to).
        || (isLeader() && changed().hasOnly(['photoPath'])
            && (!('photoPath' in request.resource.data)
                || (request.resource.data.photoPath is string
                    && request.resource.data.photoPath.matches('^circlePhotos/' + circleId + '/[A-Za-z0-9]{1,64}[.]jpg$'))))
        // The leader invites one current friend (not already in or invited), up to 30 in all.
        || (isLeader() && changed().hasOnly(['invitedIds'])
            && request.resource.data.invitedIds == resource.data.invitedIds.concat([newestInvite()])
            && isValidUid(newestInvite())
            && !(newestInvite() in resource.data.invitedIds)
            && !(newestInvite() in resource.data.memberIds)
            && areFriends(request.auth.uid, newestInvite())
            && resource.data.memberIds.size() + request.resource.data.invitedIds.size() <= 30)
        // The leader cancels an invitation.
        || (isLeader() && changed().hasOnly(['invitedIds'])
            && removedOne(resource.data.invitedIds, request.resource.data.invitedIds))
        // The leader removes a member (never themselves).
        || (isLeader() && changed().hasOnly(['memberIds'])
            && removedOne(resource.data.memberIds, request.resource.data.memberIds)
            && resource.data.leaderId in request.resource.data.memberIds)
        // An invited person accepts: from invited to member.
        || (request.auth.uid in resource.data.invitedIds
            && changed().hasOnly(['invitedIds', 'memberIds'])
            && request.resource.data.invitedIds == resource.data.invitedIds.removeAll([request.auth.uid])
            && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid]))
        // An invited person declines.
        || (request.auth.uid in resource.data.invitedIds
            && changed().hasOnly(['invitedIds'])
            && request.resource.data.invitedIds == resource.data.invitedIds.removeAll([request.auth.uid]))
        // A member (not the leader) leaves.
        || (!isLeader() && request.auth.uid in resource.data.memberIds
            && changed().hasOnly(['memberIds'])
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]))
      );

      // The leader deletes the circle (the app deletes its requests first).
      allow delete: if signedIn() && isLeader();

      // circles/{circleId}/joinRequests/{uid}: someone with the circle's
      // invite link asks to join: { uid, code, createdAt }. Only while the
      // link is on (the code matches), and not if they're already in or
      // invited. The leader sees and removes them (approve or decline);
      // the person sees and can cancel their own. Nobody else sees them.
      match /joinRequests/{uid} {
        function circleNow() {
          return get(/databases/$(database)/documents/circles/$(circleId)).data;
        }
        allow get: if signedIn() && (request.auth.uid == uid || request.auth.uid == circleNow().leaderId);
        allow list: if signedIn() && request.auth.uid == circleNow().leaderId;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'code', 'createdAt'])
          && request.resource.data.keys().hasAll(['uid', 'code', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.code is string
          && request.resource.data.code == circleNow().get('linkCode', '')
          && !(uid in circleNow().memberIds)
          && !(uid in circleNow().invitedIds);
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == circleNow().leaderId);
      }

      // circles/{circleId}/circleRequests/{requestId}:
      //   { authorId, text, createdAt, prayedBy, answeredAt?, answerNote? }
      // Only current members read or add them. Any other member can mark
      // "I prayed" (their own uid in prayedBy, once) until it's answered;
      // the author marks it answered (with an optional note) or undoes that.
      // The author or the leader deletes one.
      match /circleRequests/{requestId} {
        function circleData() {
          return get(/databases/$(database)/documents/circles/$(circleId)).data;
        }
        function isMember() {
          return signedIn() && request.auth.uid in circleData().memberIds;
        }
        function reqChanged() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        allow get, list: if isMember();

        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt', 'prayedBy'])
          && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt', 'prayedBy'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.trim().size() >= 1
          && request.resource.data.text.size() <= 300
          && request.resource.data.prayedBy == []
          && request.resource.data.createdAt == request.time;

        allow update: if isMember() && (
          (reqChanged().hasOnly(['prayedBy'])
            && request.auth.uid != resource.data.authorId
            && ((!('answeredAt' in resource.data)
                 && !(request.auth.uid in resource.data.prayedBy)
                 && request.resource.data.prayedBy == resource.data.prayedBy.concat([request.auth.uid]))
                || (request.auth.uid in resource.data.prayedBy
                 && request.resource.data.prayedBy == resource.data.prayedBy.removeAll([request.auth.uid]))))
          || (request.auth.uid == resource.data.authorId
            && reqChanged().hasOnly(['answeredAt', 'answerNote'])
            && ((request.resource.data.answeredAt == request.time
                 && (!('answerNote' in request.resource.data)
                     || (request.resource.data.answerNote is string && request.resource.data.answerNote.size() <= 120)))
                || (!('answeredAt' in request.resource.data) && !('answerNote' in request.resource.data))))
        );

        allow delete: if signedIn()
          && (request.auth.uid == resource.data.authorId || request.auth.uid == circleData().leaderId);
      }
    }

    // ---------- app version (the "new version is ready" banner) ----------
    // config/app: { latestBuild, minimumBuild? }, set by the owner in the
    // Firebase console after a TestFlight build is ready. Anyone signed in
    // can read it; no app can change it.
    match /config/{docId} {
      allow get: if signedIn() && docId == 'app';
      allow list, write: if false;
    }

    // ---------- prayer circle invite links ----------
    // circleLinks/{code}: { circleId, name, createdAt }. The card behind a
    // circle's invite link: anyone signed in who has the link (the random
    // code) can read it, to see the circle's name and ask to join. No list,
    // so codes can't be found. Only the circle's leader makes, renames or
    // removes one.
    match /circleLinks/{code} {
      function linkLeader(circleId) {
        return get(/databases/$(database)/documents/circles/$(circleId)).data.leaderId;
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Za-z0-9]{20,40}$')
        && request.resource.data.keys().hasOnly(['circleId', 'name', 'createdAt'])
        && request.resource.data.keys().hasAll(['circleId', 'name', 'createdAt'])
        && request.resource.data.circleId is string
        && request.auth.uid == linkLeader(request.resource.data.circleId)
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == linkLeader(resource.data.circleId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40;
      allow delete: if signedIn() && request.auth.uid == linkLeader(resource.data.circleId);
    }

    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter', 'kind', 'targetUid', 'postId', 'commentId', 'circleId', 'requestId', 'reason', 'note', 'excerpt', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporter', 'kind', 'targetUid', 'reason', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.kind in ['user', 'post', 'comment', 'circleRequest']
        && isValidUid(request.resource.data.targetUid)
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'harm', 'other']
        && (request.resource.data.kind in ['user', 'circleRequest'] || request.resource.data.postId is string)
        && (request.resource.data.kind != 'circleRequest'
            || (request.resource.data.circleId is string && request.resource.data.requestId is string))
        && (request.resource.data.kind != 'comment' || request.resource.data.commentId is string)
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && (!('excerpt' in request.resource.data) || (request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 2000))
        && request.resource.data.createdAt == request.time;
    }

    // ---------- posts ----------
    // posts/{promptId}_{authorId}: at most one post per user per prompt.
    // verseRef (optional) is copied from the prompt and can't be changed;
    // verseBook is its book.
    //
    // On-time vs late is not stored as a flag the client could fake. It is
    // derived from two values the rules pin down:
    //   createdAt     == request.time (server clock)
    //   promptFiredAt == the prompt's firedAt
    // late = createdAt > promptFiredAt + 7 minutes (2-min window + 5-min
    // grace). See app/src/lib/posts.ts isLate(). Late is a label only:
    // nothing is ranked or counted by it.
    match /posts/{postId} {
      function prompt() {
        return get(/databases/$(database)/documents/prompts/$(request.resource.data.promptId)).data;
      }

      function validNotes(n) {
        return n is string && n.size() >= 1 && n.size() <= 2000;
      }

      // Where the post was made, as a place name only (e.g. "Austin, Texas").
      // Optional and opt-in per post; coordinates are never stored.
      function validPlace(p) {
        return p is string && p.size() >= 1 && p.size() <= 80;
      }

      // The photo lives in the author's own folder; storage.rules only lets
      // the author write there. A private post's photo lives in a separate
      // folder that only its author can ever read.
      function validPhotoPath(p, visibility) {
        return p is string
          && p.matches('^' + (visibility == 'private' ? 'privatePhotos/' : 'postPhotos/')
                       + request.auth.uid + '/[A-Za-z0-9]{1,64}[.]jpg$');
      }

      // Read access is the core privacy guarantee of the app: only the
      // author, and the author's CURRENT mutual friends unless the post is
      // private (a journal entry for the author alone). Feed queries must
      // say visibility == 'friends' for the rules to allow them. Keep this an
      // exact equality: a lenient form (e.g. .get('visibility', 'friends'))
      // let an unfiltered friend query return private posts in the emulator.
      // Posts from before visibility existed are therefore author-only.
      allow get, list: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.visibility == 'friends' && areFriends(request.auth.uid, resource.data.authorId)));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['authorId', 'promptId', 'promptFiredAt', 'createdAt', 'notes', 'photoPath', 'verseRef', 'verseBook', 'place', 'visibility', 'takenAt', 'startedAt'])
        && request.resource.data.keys().hasAll(
             ['authorId', 'promptId', 'promptFiredAt', 'createdAt', 'notes', 'photoPath', 'visibility'])
        && request.resource.data.visibility in ['friends', 'private']
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.promptId is string
        && request.resource.data.promptId.matches('^[0-9]{8}$')
        && postId == request.resource.data.promptId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/prompts/$(request.resource.data.promptId))
        && request.resource.data.promptFiredAt == prompt().firedAt
        // The verse is the prompt's, carried onto the post: present exactly
        // when the prompt has one, and identical to it. A reference only.
        && request.resource.data.get('verseRef', null) == prompt().get('verseRef', null)
        // verseBook ("PHP") is the reference's book, for filtering my own
        // prayers by book: present exactly when verseRef is.
        && (('verseRef' in request.resource.data)
            ? request.resource.data.get('verseBook', null) == request.resource.data.verseRef.split('[.]')[0]
            : !('verseBook' in request.resource.data))
        // Can't answer a prompt before it fires, and a prompt stays open
        // for (late) posts for 24 hours.
        && request.time >= prompt().firedAt
        && request.time < prompt().firedAt + duration.value(24, 'h')
        && request.resource.data.createdAt == request.time
        // startedAt: when I pressed "Pray now" (users/{me}/starts/{promptId},
        // which only exists if that was on time). Must be exactly that, and
        // the post must come within 15 minutes of it to carry it; without
        // it, on time vs late is decided by createdAt as before.
        && (!('startedAt' in request.resource.data) || (
              exists(/databases/$(database)/documents/users/$(request.auth.uid)/starts/$(request.resource.data.promptId))
              && request.resource.data.startedAt == get(/databases/$(database)/documents/users/$(request.auth.uid)/starts/$(request.resource.data.promptId)).data.startedAt
              && request.time <= request.resource.data.startedAt + duration.value(15, 'm')))
        // takenAt: when the photo was taken, by the phone's clock. Only shown
        // ("taken 3:02") for a post that was queued offline; on time vs late
        // is always decided by createdAt, the server's time. Loosely bounded
        // because phone clocks drift.
        && (!('takenAt' in request.resource.data) || (request.resource.data.takenAt is timestamp
            && request.resource.data.takenAt >= prompt().firedAt - duration.value(10, 'm')
            && request.resource.data.takenAt <= request.time + duration.value(5, 'm')))
        && validNotes(request.resource.data.notes)
        && validPhotoPath(request.resource.data.photoPath, request.resource.data.visibility)
        && (!('place' in request.resource.data) || validPlace(request.resource.data.place));

      // Editable by the author: the notes only. The photo is what was taken
      // at the moment, so it can't be replaced (delete the post instead).
      // editedAt marks the post as edited and must be the server time.
      // Timing fields never change, so editing can't turn a late post into an
      // on-time one. Visibility can't change either.
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'editedAt', 'place'])
        && request.resource.data.editedAt == request.time
        && validNotes(request.resource.data.notes)
        // The place can be removed, but not added or changed after posting:
        // it records where the post was made.
        && (!('place' in request.resource.data) || request.resource.data.place == resource.data.get('place', null));

      // "This prayer was answered", marked later by the author, with an
      // optional note on how. A separate update from editing: it doesn't need
      // editedAt (the prayer itself didn't change) and can't be combined with
      // an edit. answeredAt is the server time when first marked and stays put
      // while only the note changes; unmarking removes both fields.
      function validAnswer() {
        let d = request.resource.data;
        return (!('answeredAt' in d) && !('answerNote' in d))
          || ('answeredAt' in d
              && (d.answeredAt == request.time || d.answeredAt == resource.data.get('answeredAt', null))
              && (!('answerNote' in d) || (d.answerNote is string && d.answerNote.size() >= 1 && d.answerNote.size() <= 1000)));
      }

      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answeredAt', 'answerNote'])
        && validAnswer();

      // Deletable by the author. The photo and comments are removed by
      // Cloud Functions.
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // For comments and reactions: the post's author, and whether I may see
      // the post (its author, or their current mutual friend if it isn't
      // private). get() of a deleted post fails, so its comments and
      // reactions become unreadable. Private posts get none from anyone else.
      function postData() {
        return get(/databases/$(database)/documents/posts/$(postId)).data;
      }

      function postAuthor() {
        return postData().authorId;
      }

      function canSeePost() {
        return postAuthor() == request.auth.uid
          || (postData().visibility == 'friends' && areFriends(request.auth.uid, postAuthor()));
      }

      // Comments. A comment is shown only to people who are CURRENT mutual
      // friends of its author and can see the post: the post's author, or
      // a friend of theirs. So nobody's words reach someone who isn't their
      // friend, and unfriending hides comments both ways. A comment's author
      // can always read their own.

      match /comments/{commentId} {
        allow get, list: if signedIn() && (
          resource.data.authorId == request.auth.uid ||
          (areFriends(request.auth.uid, resource.data.authorId) && canSeePost()));

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.trim().size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && canSeePost();

        // Comments can't be edited. The commenter or the post's author can
        // delete one.
        allow update: if false;
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid || postAuthor() == request.auth.uid);
      }

      // Reactions: one preset reaction per person per post, BeReal-style.
      // The doc id is the reactor's uid. Same visibility as comments: only
      // the reactor's current mutual friends who can see the post (and the
      // reactor). Not on your own post. Change it by writing again; remove
      // it by deleting. Must match app/src/lib/reactions.ts.
      match /reactions/{reactorId} {
        function reactionKinds() {
          return ['praying', 'love', 'happy', 'amen', 'cool', 'hug'];
        }

        allow get, list: if signedIn() && (
          resource.data.authorId == request.auth.uid ||
          (areFriends(request.auth.uid, resource.data.authorId) && canSeePost()));

        allow create, update: if signedIn()
          && reactorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'kind', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'kind', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.kind in reactionKinds()
          && request.resource.data.createdAt == request.time
          && canSeePost()
          && postAuthor() != request.auth.uid;

        allow delete: if signedIn() && reactorId == request.auth.uid;
      }
    }
  }
}

rules_version = '2';

// Security model (see docs/step1-auth-friends.md for the full rationale):
//
// * Friendship = mutual follow. A friendship exists between A and B only
//   while BOTH follows/{A}_{B} and follows/{B}_{A} exist.
// * Post visibility is decided at read time against those live follow docs,
//   never against a copied/denormalized friend list. Deleting either follow
//   doc revokes access on the very next server read.
// * Everything not explicitly allowed below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      // Anonymous accounts are rejected even if the provider is accidentally
      // enabled in the console: they would let anyone mint unlimited
      // identities to spam follow requests.
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernameDoc(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    function follows(a, b) {
      return exists(/databases/$(database)/documents/follows/$(a + '_' + b));
    }

    function areFriends(a, b) {
      return follows(a, b) && follows(b, a);
    }

    // Firebase Auth uids are alphanumeric. Requiring that here keeps the
    // "{follower}_{followee}" doc id unambiguous.
    function isValidUid(uid) {
      return uid is string && uid.matches('^[A-Za-z0-9]{1,128}$');
    }

    function isValidUsername(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$');
    }

    function isValidDisplayName(name) {
      return name is string && name.size() >= 1 && name.size() <= 50;
    }

    // ---------- public profiles ----------
    // Minimal: username, display name and (optional) profile photo path.
    // Readable by any signed-in user who already knows the uid (needed to
    // show a follow request / friend, and to recognise who it is). Listing
    // is denied so the user base can't be enumerated. The bio is NOT here:
    // it's friends-only (users/{uid}/friendsOnly/about below).
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;

      // Profile + username claim must be written in the same batch.
      allow create: if isSelf(uid)
        && isValidUid(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['username', 'displayName', 'createdAt'])
        && isValidUsername(request.resource.data.username)
        && isValidDisplayName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        && getAfter(usernameDoc(request.resource.data.username)).data.uid == uid;

      // Display name and profile photo are mutable; usernames are fixed in
      // v1. The photo must be in the owner's own avatars/ folder (storage
      // rules only let the owner write there); removing it deletes the field.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarPath'])
        && isValidDisplayName(request.resource.data.displayName)
        && (!('avatarPath' in request.resource.data)
            || (request.resource.data.avatarPath is string
                && request.resource.data.avatarPath.matches('^avatars/' + uid + '/[A-Za-z0-9]{1,64}[.]jpg$')));

      // Account deletion goes through a Cloud Function (step 5) so that the
      // user's posts, follows and photos are removed together.
      allow delete: if false;

      // ---------- friends-only profile ----------
      // users/{uid}/friendsOnly/about: { bio } (up to 160 characters).
      // Same boundary as posts: only the owner and CURRENT mutual friends,
      // checked against the live follow docs on every read.
      match /friendsOnly/{docId} {
        allow get: if docId == 'about' && signedIn() && (
          request.auth.uid == uid || areFriends(request.auth.uid, uid));
        allow list: if false;
        // The friends-only "about" fields. Each is optional; an empty field
        // is left out rather than stored empty (the bio may be "").
        function optionalText(d, key, max) {
          return !(key in d) || (d[key] is string && d[key].size() >= 1 && d[key].size() <= max);
        }
        // "MM-DD", or "YYYY-MM-DD" if they choose to share the year.
        function validBirthday(d) {
          return !('birthday' in d) || (d.birthday is string
            && d.birthday.matches('^([0-9]{4}-)?(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
        }
        allow create, update: if isSelf(uid)
          && docId == 'about'
          && request.resource.data.keys().hasOnly(['bio', 'birthday', 'hometown', 'prayerRequests', 'bibleVersion', 'denomination', 'church'])
          && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
          && validBirthday(request.resource.data)
          && optionalText(request.resource.data, 'prayerRequests', 500)
          && optionalText(request.resource.data, 'bibleVersion', 40)
          && optionalText(request.resource.data, 'denomination', 60)
          && optionalText(request.resource.data, 'church', 80)
          && optionalText(request.resource.data, 'hometown', 80);
        // Clear the bio by saving an empty one; the doc goes with the account (step 5).
        allow delete: if false;
      }

      // ---------- private settings ----------
      // users/{uid}/private/settings: only the owner can read or write it.
      // Friends never see it.
      //   bibleVersion: the translation this user reads verses in.
      // Only translations on this list can be chosen. KJV is public domain;
      // licensed translations are added here only once their licence
      // allows it. Must match app/src/lib/scripture/translations.ts.
      match /private/{docId} {
        function allowedTranslations() {
          return ['KJV'];
        }

        allow get: if isSelf(uid) && docId == 'settings';
        allow list: if false;
        allow create, update: if isSelf(uid)
          && docId == 'settings'
          && request.resource.data.keys().hasOnly(['bibleVersion'])
          && request.resource.data.bibleVersion in allowedTranslations();
        // Removed with the account (step 5), not by clients.
        allow delete: if false;
      }
    }

    // ---------- username -> uid index ----------
    // Exact-match lookup only ("add friend by username"). No list.
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;

      // A user can claim exactly one username: only while creating their
      // profile (profile must not exist yet, and must exist after the batch
      // pointing back at this username). Create fails if already taken
      // because the doc already exists (that would be an update).
      allow create: if signedIn()
        && isValidUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(userDoc(request.auth.uid))
        && getAfter(userDoc(request.auth.uid)).data.username == username;

      allow update, delete: if false;
    }

    // ---------- follows (friend requests / friendships) ----------
    // follows/{followerId}_{followeeId}
    //   A one-directional follow is a pending friend request.
    //   Both directions present = friends.
    match /follows/{followId} {
      function party() {
        return signedIn() && (
          resource.data.followerId == request.auth.uid ||
          resource.data.followeeId == request.auth.uid);
      }

      // Only the two people involved can see a follow edge. Queries must be
      // constrained to `followerId == me` or `followeeId == me`.
      allow get, list: if party();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerId', 'followeeId', 'createdAt'])
        && request.resource.data.keys().hasAll(['followerId', 'followeeId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && isValidUid(request.resource.data.followeeId)
        && request.resource.data.followeeId != request.auth.uid
        && followId == request.resource.data.followerId + '_' + request.resource.data.followeeId
        && request.resource.data.createdAt == request.time
        && exists(userDoc(request.resource.data.followeeId))
        // Follower must have a profile too, so requests always render.
        && exists(userDoc(request.auth.uid));

      // Edges are immutable; changing followerId/followeeId would forge
      // friendships.
      allow update: if false;

      // Either party may delete an edge:
      //   follower deletes -> cancel request / unfriend
      //   followee deletes -> decline request / unfriend
      allow delete: if party();
    }

    // ---------- prompts ----------
    // prompts/{yyyymmdd}: one global prompt per day (v1: everyone at once).
    //   firedAt:  timestamp the prompt went out
    //   verseRef: optional canonical verse reference id (e.g. "PHP.4.6-7")
    //             from the curated list; never verse text
    // Written only by the server (Cloud Function in step 4, or the dev seed
    // script against the emulator). Readable by any signed-in user.
    match /prompts/{promptId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- posts ----------
    // posts/{promptId}_{authorId}: at most one post per user per prompt.
    // verseRef (optional) is copied from the prompt and can't be changed.
    //
    // On-time vs late is not stored as a flag the client could fake. It is
    // derived from two values the rules pin down:
    //   createdAt     == request.time (server clock)
    //   promptFiredAt == the prompt's firedAt
    // late = createdAt > promptFiredAt + 7 minutes (2-min window + 5-min
    // grace). See app/src/lib/posts.ts isLate(). Late is a label only:
    // nothing is ranked or counted by it.
    match /posts/{postId} {
      function prompt() {
        return get(/databases/$(database)/documents/prompts/$(request.resource.data.promptId)).data;
      }

      function validNotes(n) {
        return n is string && n.size() >= 1 && n.size() <= 2000;
      }

      // Where the post was made, as a place name only (e.g. "Austin, Texas").
      // Optional and opt-in per post; coordinates are never stored.
      function validPlace(p) {
        return p is string && p.size() >= 1 && p.size() <= 80;
      }

      // The photo lives in the author's own folder; storage.rules only lets
      // the author write there.
      function validPhotoPath(p) {
        return p is string
          && p.matches('^postPhotos/' + request.auth.uid + '/[A-Za-z0-9]{1,64}[.]jpg$');
      }

      // Read access is the core privacy guarantee of the app: only the
      // author and the author's CURRENT mutual friends.
      allow get, list: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        areFriends(request.auth.uid, resource.data.authorId));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['authorId', 'promptId', 'promptFiredAt', 'createdAt', 'notes', 'photoPath', 'verseRef', 'place'])
        && request.resource.data.keys().hasAll(
             ['authorId', 'promptId', 'promptFiredAt', 'createdAt', 'notes', 'photoPath'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.promptId is string
        && request.resource.data.promptId.matches('^[0-9]{8}$')
        && postId == request.resource.data.promptId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/prompts/$(request.resource.data.promptId))
        && request.resource.data.promptFiredAt == prompt().firedAt
        // The verse is the prompt's, carried onto the post: present exactly
        // when the prompt has one, and identical to it. A reference only.
        && request.resource.data.get('verseRef', null) == prompt().get('verseRef', null)
        // Can't answer a prompt before it fires, and a prompt stays open
        // for (late) posts for 24 hours.
        && request.time >= prompt().firedAt
        && request.time < prompt().firedAt + duration.value(24, 'h')
        && request.resource.data.createdAt == request.time
        && validNotes(request.resource.data.notes)
        && validPhotoPath(request.resource.data.photoPath)
        && (!('place' in request.resource.data) || validPlace(request.resource.data.place));

      // Editable by the author: notes and/or photo. editedAt marks the post
      // as edited and must be the server time. Timing fields never change,
      // so editing can't turn a late post into an on-time one.
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'photoPath', 'editedAt', 'place'])
        && request.resource.data.editedAt == request.time
        && validNotes(request.resource.data.notes)
        && validPhotoPath(request.resource.data.photoPath)
        // The place can be removed, but not added or changed after posting:
        // it records where the post was made.
        && (!('place' in request.resource.data) || request.resource.data.place == resource.data.get('place', null));

      // "This prayer was answered", marked later by the author, with an
      // optional note on how. A separate update from editing: it doesn't need
      // editedAt (the prayer itself didn't change) and can't be combined with
      // an edit. answeredAt is the server time when first marked and stays put
      // while only the note changes; unmarking removes both fields.
      function validAnswer() {
        let d = request.resource.data;
        return (!('answeredAt' in d) && !('answerNote' in d))
          || ('answeredAt' in d
              && (d.answeredAt == request.time || d.answeredAt == resource.data.get('answeredAt', null))
              && (!('answerNote' in d) || (d.answerNote is string && d.answerNote.size() >= 1 && d.answerNote.size() <= 1000)));
      }

      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answeredAt', 'answerNote'])
        && validAnswer();

      // Deletable by the author. The photo and comments are removed by
      // Cloud Functions.
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // Comments. A comment is shown only to people who are CURRENT mutual
      // friends of its author and can see the post: the post's author, or
      // a friend of theirs. So nobody's words reach someone who isn't their
      // friend, and unfriending hides comments both ways. A comment's author
      // can always read their own. Orphans (post deleted) are unreadable,
      // because get() of a missing post fails.
      // For comments and reactions: the post's author, and whether I may see
      // the post (its author, or their current mutual friend). get() of a
      // deleted post fails, so its comments and reactions become unreadable.
      function postAuthor() {
        return get(/databases/$(database)/documents/posts/$(postId)).data.authorId;
      }

      function canSeePost() {
        return postAuthor() == request.auth.uid || areFriends(request.auth.uid, postAuthor());
      }

      match /comments/{commentId} {
        allow get, list: if signedIn() && (
          resource.data.authorId == request.auth.uid ||
          (areFriends(request.auth.uid, resource.data.authorId) && canSeePost()));

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.trim().size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && canSeePost();

        // Comments can't be edited. The commenter or the post's author can
        // delete one.
        allow update: if false;
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid || postAuthor() == request.auth.uid);
      }

      // Reactions: one preset reaction per person per post, BeReal-style.
      // The doc id is the reactor's uid. Same visibility as comments: only
      // the reactor's current mutual friends who can see the post (and the
      // reactor). Not on your own post. Change it by writing again; remove
      // it by deleting. Must match app/src/lib/reactions.ts.
      match /reactions/{reactorId} {
        function reactionKinds() {
          return ['praying', 'love', 'happy', 'amen', 'cool', 'hug'];
        }

        allow get, list: if signedIn() && (
          resource.data.authorId == request.auth.uid ||
          (areFriends(request.auth.uid, resource.data.authorId) && canSeePost()));

        allow create, update: if signedIn()
          && reactorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'kind', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'kind', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.kind in reactionKinds()
          && request.resource.data.createdAt == request.time
          && canSeePost()
          && postAuthor() != request.auth.uid;

        allow delete: if signedIn() && reactorId == request.auth.uid;
      }
    }
  }
}

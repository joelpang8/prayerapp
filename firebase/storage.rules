rules_version = '2';

// Post photos: postPhotos/{authorId}/{photoId}
//
// Same privacy boundary as posts in firestore.rules: only the author and the
// author's CURRENT mutual friends may read a photo, checked against the live
// follow docs on every request.
//
// Clients must never use getDownloadURL() for these objects: a download URL
// carries a token that bypasses these rules and never expires. The app
// fetches bytes through the SDK (getBytes), which is rule-checked each time.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function follows(a, b) {
      return firestore.exists(/databases/(default)/documents/follows/$(a + '_' + b));
    }

    function areFriends(a, b) {
      return follows(a, b) && follows(b, a);
    }

    match /postPhotos/{authorId}/{photoId} {
      allow get: if signedIn() && (
        request.auth.uid == authorId ||
        areFriends(request.auth.uid, authorId));

      // No listing: even the author enumerates their photos via their posts.
      allow list: if false;

      // Author uploads (or replaces, when editing a post) a JPEG under 5 MB.
      // The client re-encodes captures to JPEG before upload.
      allow create, update: if signedIn()
        && request.auth.uid == authorId
        && photoId.matches('^[A-Za-z0-9]{1,64}\\.jpg$')
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';

      allow delete: if signedIn() && request.auth.uid == authorId;
    }

    // Private posts' photos: privatePhotos/{authorId}/{photoId}.jpg
    // Only the author can ever read them (no friends, no exceptions).
    match /privatePhotos/{authorId}/{photoId} {
      allow get: if signedIn() && request.auth.uid == authorId;
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == authorId
        && photoId.matches('^[A-Za-z0-9]{1,64}\\.jpg$')
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if signedIn() && request.auth.uid == authorId;
    }

    // Profile photos: avatars/{uid}/{avatarId}.jpg
    // Visible to any signed-in user (decided: people should recognise who a
    // friend request is from). Like post photos, they're read through the
    // SDK, never via download URLs. Owner-only writes, square JPEG < 2 MB.
    match /avatars/{uid}/{avatarId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && avatarId.matches('^[A-Za-z0-9]{1,64}\\.jpg$')
        && request.resource.size > 0
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Everything else in the bucket is closed.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
